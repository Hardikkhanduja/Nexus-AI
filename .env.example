# Database Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_db?schema=public

# Authentication Security keys (generate cryptographically secure values in production)
JWT_SECRET=your-jwt-access-secret-key-at-least-32-characters
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-at-least-32-characters

# OAuth Apps Credentials (leave empty if not configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL Configurations
FRONTEND_URL=http://localhost:5173
PORT=3000

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

